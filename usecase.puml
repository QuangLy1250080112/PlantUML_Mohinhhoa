@startuml name "Hệ thống Triển lãm Trực tuyến Tương tác" title "Use Case Diagram - Hệ thống Triển lãm Trực tuyến Tương tác"
left to right direction

' Khai báo Tác nhân bên trái
actor "Khách tham quan\n(Visitor)" as Visitor
actor "Biên tập viên\n(Curator)" as Curator

rectangle "Hệ thống Triển lãm Trực tuyến Tương tác" {
  usecase "Trải nghiệm triển lãm" as UC1
  usecase "Quản lý nội dung triển lãm" as UC2
  usecase "Quản lý tài khoản" as UC3
  usecase "Xuất bản triển lãm" as UC4
  usecase "Quản trị hệ thống" as UC5
}

' Khai báo Tác nhân bên phải
actor "Quản trị viên\n(Admin)" as Admin
actor "Dịch vụ hệ thống\n(System Core Service)" as SystemService

' Nối liên kết phía bên trái (Actor -> Use Case)
Visitor -- UC1
Curator -- UC2
Curator -- UC3
Curator -- UC4

' Nối liên kết phía bên phải (Use Case -> Actor để đẩy Actor sang phải)
UC3 -- Admin
UC4 -- Admin
UC5 -- Admin

UC5 -- SystemService
@endl